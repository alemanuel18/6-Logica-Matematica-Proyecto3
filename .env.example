# Puertos publicados en la máquina anfitriona.
WEB_PORT=3100
API_PORT=4100

# URL que usa el navegador para llamar a la API. Se incorpora al frontend al construir la imagen.
NEXT_PUBLIC_API_URL=http://localhost:4100

# Origen permitido por CORS en la API. Debe coincidir con la URL desde la que abres la web.
WEB_ORIGIN=http://localhost:3100

# Clave de Gemini: copiar en .env local. Nunca se expone al frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
